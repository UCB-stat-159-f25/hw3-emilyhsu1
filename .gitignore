# --------------------
# Python cache & build
# --------------------
__pycache__/
*.py[cod]
*.so
build/
dist/
*.egg-info/
.eggs/
*.whl

# --------------------
# Jupyter
# --------------------
.ipynb_checkpoints/
*.nbconvert.ipynb
Untitled*.ipynb

# --------------------
# MyST build artifacts
# --------------------
_build/
.env-ready

# --------------------
# OS files
# --------------------
.DS_Store

# --------------------
# Auto-generated notebook outputs
# Only ignore files INSIDE these folders
# --------------------
figures/*
audio/*
!figures/.gitkeep
!audio/.gitkeep

# --------------------
# Data (keep ALL inputs)
# --------------------
!data/
# Do NOT ignore .json or .hdf5 in data/
# They are required for the notebook

# --------------------
# Temporary & misc
# --------------------
*.log
*.tmp
